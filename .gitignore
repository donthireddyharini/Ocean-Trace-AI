# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.class
*.pyc
*.pyo

# Environments & Virtual Envs
.env
.env.*
!.env.example
.venv/
venv/
env/

# Large media & zip files
*.mp4
*.zip

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Large data directories (never commit raw/processed data)
data/raw/
data/processed/

# Model checkpoints
artifacts/checkpoints/*.pth
artifacts/checkpoints/*.pt
artifacts/checkpoints/*.ckpt

# Databases
*.db
*.sqlite3

# Package build artefacts & test caches
*.egg-info/
dist/
build/
.pytest_cache/
.ipynb_checkpoints/
.vercel/

.vercel
.env*
